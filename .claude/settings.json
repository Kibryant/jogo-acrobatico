{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Explanatory",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(backlog task view:*)",
      "Bash(backlog task list:*)",
      "Bash(backlog board:*)",
      "Bash(bash tools/:*)",
      "Bash(godot --version)",
      "Bash(godot --headless:*)",
      "Bash(gdscript-formatter:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh repo create:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
