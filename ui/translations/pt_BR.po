# The on-screen texts in Brazilian Portuguese (DEC-0031 §8), one message per key of
# ui/game_text.gd. The keys and the comments stay in English; the messages are what players read.
msgid ""
msgstr ""
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

# A client opened with --connect, waiting for the server to accept it.
msgid "NET_CONNECTING"
msgstr "Conectando ao servidor…"

# The server already seats its players (TASK-9, choice 4).
msgid "NET_ROOM_FULL"
msgstr "A sala está cheia. Tente de novo mais tarde."

# The server runs another version or commit of the game (TASK-9, choice 10).
msgid "NET_UPDATE_REQUIRED"
msgstr "O servidor roda outra versão do jogo. Atualize o jogo para entrar."

# No answer from the server in time.
msgid "NET_SERVER_NOT_RESPONDING"
msgstr "O servidor não respondeu. Confira o endereço e se ele está no ar."

# The server ended the session: its stop file, or the connection dropped.
msgid "NET_SERVER_CLOSED"
msgstr "O servidor fechou a partida."

# The HUD's mode of the fighter: standing, running or stopping on the floor (TASK-10.2).
msgid "HUD_MODE_GROUND"
msgstr "No chão"

# The HUD's mode of the fighter: from leaving the floor to touching it again (TASK-10.2).
msgid "HUD_MODE_AIR"
msgstr "No ar"

# The HUD's mode of the fighter: the 200 ms of the dash, from the press to its end (TASK-10.4).
msgid "HUD_MODE_DASH"
msgstr "No dash"

# The HUD's mode of the fighter: from the touch on a wall to the end of the run, by its time, the
# wall jump, the edge, the floor or an obstacle (TASK-10.5).
msgid "HUD_MODE_WALL_RUN"
msgstr "Na parede"

# The HUD's mode of the fighter: the pull of the grapple, from the first tick after the cable's
# 100 ms to the release, by the distance, the jump or the block (TASK-10.6).
msgid "HUD_MODE_GRAPPLE"
msgstr "No gancho"

# The HUD's time until the next dash, beside its arc: {whole} and {tenth} are the digits of the
# seconds, rounded up to the tenth (TASK-10.4).
msgid "HUD_DASH_COOLDOWN"
msgstr "{whole},{tenth} s"

# The HUD's time until the next grapple, beside its arc, above the dash's row: {whole} and
# {tenth} are the digits of the seconds, rounded up to the tenth (TASK-10.6).
msgid "HUD_GRAPPLE_COOLDOWN"
msgstr "Gancho {whole},{tenth} s"

# Every tick of the replay played in the window has played (--watch; TASK-10.3).
msgid "REPLAY_ENDED"
msgstr "Fim do replay. Feche a janela para sair."
