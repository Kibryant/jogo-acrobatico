# The on-screen texts in Brazilian Portuguese (DEC-0031 §8), one message per key of
# ui/game_text.gd. The keys and the comments stay in English; the messages are what players read.
msgid ""
msgstr ""
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

# A client opened with --connect, waiting for the server to accept it.
msgid "NET_CONNECTING"
msgstr "Conectando ao servidor…"

# The server already seats its players (TASK-9, choice 4).
msgid "NET_ROOM_FULL"
msgstr "A sala está cheia. Tente de novo mais tarde."

# The server runs another version or commit of the game (TASK-9, choice 10).
msgid "NET_UPDATE_REQUIRED"
msgstr "O servidor roda outra versão do jogo. Atualize o jogo para entrar."

# No answer from the server in time.
msgid "NET_SERVER_NOT_RESPONDING"
msgstr "O servidor não respondeu. Confira o endereço e se ele está no ar."

# The server ended the session: its stop file, or the connection dropped.
msgid "NET_SERVER_CLOSED"
msgstr "O servidor fechou a partida."

# The HUD's mode of the fighter: standing, running or stopping on the floor (TASK-10.2).
msgid "HUD_MODE_GROUND"
msgstr "No chão"

# The HUD's mode of the fighter: from leaving the floor to touching it again (TASK-10.2).
msgid "HUD_MODE_AIR"
msgstr "No ar"

# The HUD's mode of the fighter: the 200 ms of the dash, from the press to its end (TASK-10.4).
msgid "HUD_MODE_DASH"
msgstr "No dash"

# The HUD's mode of the fighter: from the touch on a wall to the end of the run, by its time, the
# wall jump, the edge, the floor or an obstacle (TASK-10.5).
msgid "HUD_MODE_WALL_RUN"
msgstr "Na parede"

# The HUD's mode of the fighter: the pull of the grapple, from the first tick after the cable's
# 100 ms to the release, by the distance, the jump or the block (TASK-10.6).
msgid "HUD_MODE_GRAPPLE"
msgstr "No gancho"

# The HUD's time until the next dash, beside its arc: {whole} and {tenth} are the digits of the
# seconds, rounded up to the tenth (TASK-10.4).
msgid "HUD_DASH_COOLDOWN"
msgstr "{whole},{tenth} s"

# The HUD's time until the next grapple, beside its arc, above the dash's row: {whole} and
# {tenth} are the digits of the seconds, rounded up to the tenth (TASK-10.6).
msgid "HUD_GRAPPLE_COOLDOWN"
msgstr "Gancho {whole},{tenth} s"

# Every tick of the replay played in the window has played (--watch; TASK-10.3).
msgid "REPLAY_ENDED"
msgstr "Fim do replay. Feche a janela para sair."

# The title of the options screen, opened with the Esc (TASK-10.9).
msgid "OPTIONS_TITLE"
msgstr "Opções"

# The group of the seven actions and their keys.
msgid "OPTIONS_GROUP_KEYS"
msgstr "Teclas"

# The group of the mouse's sensitivity. The same word in both languages.
msgid "OPTIONS_GROUP_MOUSE"
msgstr "Mouse"

# The group of the interface's scale. The same word in both languages.
msgid "OPTIONS_GROUP_INTERFACE"
msgstr "Interface"

# The action move_forward.
msgid "OPTIONS_ACTION_MOVE_FORWARD"
msgstr "Andar para a frente"

# The action move_back.
msgid "OPTIONS_ACTION_MOVE_BACK"
msgstr "Andar para trás"

# The action move_left.
msgid "OPTIONS_ACTION_MOVE_LEFT"
msgstr "Andar para a esquerda"

# The action move_right.
msgid "OPTIONS_ACTION_MOVE_RIGHT"
msgstr "Andar para a direita"

# The action jump.
msgid "OPTIONS_ACTION_JUMP"
msgstr "Pular"

# The action dash. The maneuver's name in both languages.
msgid "OPTIONS_ACTION_DASH"
msgstr "Dash"

# The action grapple.
msgid "OPTIONS_ACTION_GRAPPLE"
msgstr "Gancho"

# The action light attack (TASK-12.1).
msgid "OPTIONS_ACTION_LIGHT_ATTACK"
msgstr "Golpe leve"

# The mouse's sensitivity, from 0.02 to 0.20 degrees per pixel (F-161).
msgid "OPTIONS_SENSITIVITY"
msgstr "Sensibilidade"

# Beside the sensitivity: {cm} is the mouse's travel for a full turn at 800 DPI, in whole
# centimetres.
msgid "OPTIONS_SENSITIVITY_TURN"
msgstr "Uma volta inteira com uns {cm} cm de mouse, a 800 DPI"

# The interface's scale, from 0.8 to 1.5 (DEC-0031 §8).
msgid "OPTIONS_SCALE"
msgstr "Escala"

# Beside the scale: {whole} and {tenth} are the digits of its value.
msgid "OPTIONS_SCALE_VALUE"
msgstr "{whole},{tenth}"

# The button that puts every option back to its default.
msgid "OPTIONS_RESTORE"
msgstr "Voltar ao padrão"

# The button that closes the screen, as the Esc does.
msgid "OPTIONS_CLOSE"
msgstr "Fechar (Esc)"

# A key was clicked: the screen waits for the new key of {action}.
msgid "OPTIONS_WAITING"
msgstr "Aperte a nova tecla para {action}. O Esc cancela."

# The new key, {key}, is already the key of {action}: nothing changes (TASK-10.9,
# criterion 6).
msgid "OPTIONS_TAKEN"
msgstr "{key} já é de {action}. Escolha outra tecla ou troque {action} primeiro."

# A mouse button on an action: {number} is 3 for the middle one, 4 and 5 for the side ones.
# The same words in both languages.
msgid "OPTIONS_MOUSE_BUTTON"
msgstr "Mouse {number}"

# The left mouse button, the light attack's default (TASK-12.1).
msgid "OPTIONS_MOUSE_LEFT"
msgstr "Mouse esquerdo"
